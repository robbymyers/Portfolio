{
  "trailingSlash": true,
  "redirects": [
    { "source": "/relay", "destination": "/featured", "permanent": true },
    { "source": "/relay/:path*", "destination": "/featured", "permanent": true },
    { "source": "/procreate", "destination": "/featured", "permanent": true },
    { "source": "/procreate/:path*", "destination": "/featured", "permanent": true }
  ],
  "headers": [
    {
      "source": "/freelance-client/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
